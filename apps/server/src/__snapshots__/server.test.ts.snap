      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "description": "Atomically reorder guild channels. Uses the fixed catalog operation bulk_update_guild_channels; set previewOnly for guarded calls. Required local scope: mcp:write. Required Discord guild permissions (bot auth): MANAGE_CHANNELS. On Discord 403, call discord_permissions_explain; do not retry unchanged arguments.",
    "execution": undefined,
    "icons": undefined,
    "inputSchema": {
      "additionalProperties": false,
