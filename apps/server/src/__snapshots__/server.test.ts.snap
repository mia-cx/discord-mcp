                },
                "invitable": {
                  "anyOf": [
                    {
                      "type": "boolean",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "name": {
                  "allOf": [
                    {
                      "minLength": 1,
                    },
                    {
                      "maxLength": 100,
                    },
                  ],
                  "type": "string",
                },
                "rate_limit_per_user": {
                  "anyOf": [
                    {
                      "allOf": [
                        {
                          "minimum": 0,
                        },
                        {
                          "maximum": 21600,
                        },
                      ],
                      "type": "integer",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "type": {
                  "anyOf": [
                    {
                      "type": "null",
                    },
                    {
                      "enum": [
                        10,
                        11,
                        12,
                      ],
                      "type": "number",
                    },
                  ],
                },
              },
              "required": [
                "name",
              ],
              "type": "object",
            },
          ],
        },
        "files": {
          "allOf": [
            {
              "maxItems": 10,
            },
          ],
          "items": {
            "additionalProperties": false,
            "properties": {
              "blobId": {
                "type": "string",
              },
              "contentType": {
                "type": "string",
              },
              "filename": {
                "type": "string",
