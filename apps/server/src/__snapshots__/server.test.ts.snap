  {
    "_meta": undefined,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "description": "Update the current Discord application. Uses the fixed catalog operation update_my_application; set previewOnly for guarded calls. Required local scope: mcp:write. Required Discord guild permissions (bot auth): target-dependent; the pinned Discord OpenAPI does not declare a permission for this operation. On Discord 403, call discord_permissions_explain; do not retry unchanged arguments.",
    "execution": undefined,
    "icons": undefined,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "authMode": {
          "anyOf": [
            {
              "enum": [
                "bot",
              ],
              "type": "string",
            },
          ],
        },
        "authProfile": {
          "type": "string",
        },
        "body": {
          "additionalProperties": false,
          "properties": {
            "cover_image": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "custom_install_url": {
