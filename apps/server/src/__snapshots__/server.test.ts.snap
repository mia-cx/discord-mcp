                {
                  "allOf": [
                    {
                      "maxLength": 2048,
                    },
                  ],
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "description": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "default": {
                      "allOf": [
                        {
                          "maxLength": 400,
                        },
                      ],
                      "type": "string",
                    },
                    "localizations": {
                      "anyOf": [
                        {
                          "additionalProperties": {
                            "allOf": [
                              {
                                "maxLength": 400,
                              },
                            ],
                            "type": "string",
                          },
                          "type": "object",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                  },
                  "required": [
                    "default",
                  ],
                  "type": "object",
                },
                {
                  "type": "null",
                },
              ],
            },
            "event_webhooks_status": {
              "anyOf": [
                {
                  "type": "null",
                },
                {
                  "enum": [
                    1,
                    2,
                  ],
                  "type": "number",
                },
              ],
            },
            "event_webhooks_types": {
              "anyOf": [
                {
                  "items": {
                    "enum": [
