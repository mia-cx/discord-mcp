                      ],
                      "type": "number",
                    },
                  ],
                },
              ],
            },
            "name": {
              "allOf": [
                {
                  "minLength": 1,
                },
                {
                  "maxLength": 100,
                },
              ],
              "type": "string",
            },
            "rate_limit_per_user": {
              "anyOf": [
                {
                  "allOf": [
                    {
                      "minimum": 0,
                    },
                    {
                      "maximum": 21600,
                    },
                  ],
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
            },
          },
          "required": [
            "name",
          ],
          "type": "object",
        },
        "path": {
          "additionalProperties": false,
          "properties": {
            "channel_id": {
              "allOf": [
                {
                  "pattern": "^(0|[1-9][0-9]*)$",
                },
