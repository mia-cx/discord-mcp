                        "pattern": "^(0|[1-9][0-9]*)$",
                      },
                    ],
                    "type": "string",
                  },
                ],
              },
              "position": {
                "anyOf": [
                  {
                    "allOf": [
                      {
                        "minimum": 0,
                      },
                    ],
                    "type": "integer",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
            },
            "type": "object",
          },
          "type": "array",
        },
        "path": {
          "additionalProperties": false,
          "properties": {
            "guild_id": {
              "allOf": [
                {
                  "pattern": "^(0|[1-9][0-9]*)$",
                },
              ],
              "type": "string",
            },
          },
          "required": [
            "guild_id",
          ],
          "type": "object",
        },
        "previewOnly": {
          "type": "boolean",
        },
