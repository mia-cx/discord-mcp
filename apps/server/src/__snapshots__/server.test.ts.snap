    "description": "List Discord guilds visible to the selected profile. Uses the fixed catalog operation list_my_guilds; set previewOnly for guarded calls. Required local scope: mcp:read. Required Discord guild permissions (bot auth): target-dependent; the pinned Discord OpenAPI does not declare a permission for this operation. Required OAuth scope(s), when using OAuth2: guilds. On Discord 403, call discord_permissions_explain; do not retry unchanged arguments.",
    "execution": undefined,
    "icons": undefined,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "authMode": {
          "enum": [
            "bot",
            "oauth2",
          ],
          "type": "string",
        },
        "authProfile": {
          "type": "string",
        },
        "previewOnly": {
          "type": "boolean",
        },
        "query": {
          "additionalProperties": false,
          "properties": {
            "after": {
              "allOf": [
                {
                  "pattern": "^(0|[1-9][0-9]*)$",
                },
              ],
              "type": "string",
            },
            "before": {
              "allOf": [
                {
                  "pattern": "^(0|[1-9][0-9]*)$",
                },
              ],
              "type": "string",
            },
            "limit": {
              "allOf": [
                {
                  "minimum": 1,
                },
                {
                  "maximum": 200,
                },
              ],
              "type": "integer",
            },
            "with_counts": {
              "type": "boolean",
            },
          },
          "type": "object",
        },
      },
      "type": "object",
    },
