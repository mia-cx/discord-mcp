              },
              "type": "object",
            },
          ],
        },
      },
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "approximate_guild_count": {
