      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "description": "Create a thread from a message. Uses the fixed catalog operation create_thread_from_message; set previewOnly for guarded calls. Required local scope: mcp:write. Required Discord guild permissions (bot auth): VIEW_CHANNEL, SEND_MESSAGES, and the applicable CREATE_*_THREADS permission. On Discord 403, call discord_permissions_explain; do not retry unchanged arguments.",
    "execution": undefined,
    "icons": undefined,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "auditLogReason": {
          "type": "string",
        },
        "authMode": {
          "anyOf": [
            {
              "enum": [
                "bot",
              ],
              "type": "string",
            },
          ],
        },
        "authProfile": {
          "type": "string",
        },
        "body": {
          "additionalProperties": false,
          "properties": {
            "auto_archive_duration": {
              "anyOf": [
                {
                  "type": "null",
                },
                {
                  "anyOf": [
