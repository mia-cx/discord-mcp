              "type": "string",
            },
          },
          "required": [
            "channel_id",
          ],
          "type": "object",
        },
        "previewOnly": {
          "type": "boolean",
        },
      },
      "required": [
        "path",
        "body",
      ],
      "type": "object",
    },
