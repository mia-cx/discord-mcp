  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
    },
    "description": "Publish an announcement-channel message to every channel that follows it.

Only works in announcement channels. Requires SendMessages for the bot’s own messages, or
ManageMessages for others’. This cannot be undone: followers keep the copy.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "channelId": {
          "description": "A Discord ID: 17-21 decimal digits, always a string.",
          "examples": [
            "123456789012345678",
          ],
          "pattern": "^\\d{17,21}$",
          "title": "Snowflake",
          "type": "string",
        },
        "messageId": {
          "description": "A Discord ID: 17-21 decimal digits, always a string.",
          "examples": [
            "123456789012345678",
          ],
          "pattern": "^\\d{17,21}$",
          "title": "Snowflake",
          "type": "string",
        },
      },
      "required": [
        "channelId",
        "messageId",
      ],
      "type": "object",
    },
    "name": "discord_message_crosspost",
    "title": "Publish a message to following channels",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
