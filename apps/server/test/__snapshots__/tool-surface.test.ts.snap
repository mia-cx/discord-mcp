    "name": "discord_message_template_validate",
    "title": "Validate a template without saving it",
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Run the exact local validation and encoding path a send would, without contacting Discord.

Returns the normalized Discord payload, an ASCII layout preview, the component count,
attachment manifest, interactive bindings, and warnings. This is the preferred tool while
authoring a complex Components V2 layout: it costs nothing and shows you the structure you
just described.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "presentation": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "allowedMentions": {
                  "additionalProperties": false,
                  "properties": {
