exports[`the tool surface > advertises stable input schemas 1`] = `
[
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Recent audited actions: authentication and token administration, OAuth profile changes,
destructive previews and calls, bot-administration changes, every workflow lifecycle
transition, blueprint plan and apply, template publication, and sandbox policy violations.

Each entry records the principal, the subject, and the outcome. Retained for 90 days.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Defaults to 50.",
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "since": {
          "description": "Epoch milliseconds. Entries recorded at or after this time.",
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "audit_tail",
    "title": "Read the audit log",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": true,
    },
    "description": "Execute a cataloged bot_admin operation: bot identity, application metadata, command
registration, privileged configuration.

Requires the bot:admin scope and an unexpired preview token. These change how the bot behaves
everywhere it is installed, not just in one guild.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "auditLogReason": {
          "description": "Recorded in the guild audit log. Say why, not what.",
          "type": "string",
        },
        "authProfile": {
          "description": "Defaults to "bot". Name of a Discord OAuth2 profile otherwise.",
          "type": "string",
        },
        "body": {},
        "operationId": {
          "type": "string",
        },
        "path": {
          "additionalProperties": {
            "type": "string",
          },
          "description": "Path template parameters, e.g. { "guild_id": "123456789012345678" }.",
          "type": "object",
        },
        "previewToken": {
          "type": "string",
        },
        "query": {
          "type": "object",
        },
      },
      "required": [
        "operationId",
      ],
      "type": "object",
    },
    "name": "discord_api_admin",
    "title": "Call a bot-administration Discord API operation",
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Full detail for one operation: parameters, request body schema with its transitive $defs,
auth modes, required OAuth scopes, risk class, pagination style, audit-log support, and a
ready-to-use dispatcher example.

Call this before dispatching an operation you have not used before. It costs no Discord request.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "Exact operation ID from discord_api_search.",
          "type": "string",
        },
      },
      "required": [
        "operationId",
      ],
      "type": "object",
    },
    "name": "discord_api_describe",
    "title": "Describe a Discord API operation",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true,
    },
    "description": "Execute a cataloged destructive operation: deletes, bans, kicks, prunes, bulk changes.
Discord provides no undo for any of these.

Requires the mcp:destructive scope and an unexpired preview token from discord_api_preview
bound to this exact call. Show the user what the preview reports and get their agreement first.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "auditLogReason": {
          "description": "Recorded in the guild audit log. Say why, not what.",
          "type": "string",
        },
        "authProfile": {
          "description": "Defaults to "bot". Name of a Discord OAuth2 profile otherwise.",
          "type": "string",
        },
        "body": {},
        "operationId": {
          "type": "string",
        },
        "path": {
          "additionalProperties": {
            "type": "string",
          },
          "description": "Path template parameters, e.g. { "guild_id": "123456789012345678" }.",
          "type": "object",
        },
        "previewToken": {
          "type": "string",
        },
        "query": {
          "type": "object",
        },
      },
      "required": [
        "operationId",
      ],
      "type": "object",
    },
    "name": "discord_api_destructive",
    "title": "Call a destructive Discord API operation",
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Resolve and validate a call without performing it, and return a preview token bound to it.

Required before discord_api_destructive and discord_api_admin. The token expires after 60
seconds and binds the principal, operation, arguments, auth profile, and resolved targets, so
it authorises exactly the call it described and nothing else.
Show the user what this reports before executing.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "auditLogReason": {
          "type": "string",
        },
        "authProfile": {
          "type": "string",
        },
        "body": {},
        "operationId": {
          "type": "string",
        },
        "path": {
          "additionalProperties": {
            "type": "string",
          },
          "type": "object",
        },
        "query": {
          "type": "object",
        },
      },
      "required": [
        "operationId",
      ],
      "type": "object",
    },
    "name": "discord_api_preview",
    "title": "Preview a destructive or administrative Discord call",
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
    },
    "description": "Execute any cataloged read operation. Accepts only operations classified \`read\`, so no
mutation can be reached through this tool whatever arguments are supplied.

Prefer a curated discord_* tool when one exists. Arguments are validated locally first:
unknown query keys, malformed IDs, and missing path parameters fail without a Discord request.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "auditLogReason": {
          "description": "Recorded in the guild audit log. Say why, not what.",
          "type": "string",
        },
        "authProfile": {
          "description": "Defaults to "bot". Name of a Discord OAuth2 profile otherwise.",
          "type": "string",
        },
        "body": {},
        "operationId": {
          "type": "string",
        },
        "path": {
          "additionalProperties": {
            "type": "string",
          },
          "description": "Path template parameters, e.g. { "guild_id": "123456789012345678" }.",
          "type": "object",
        },
        "previewToken": {
          "type": "string",
        },
        "query": {
          "type": "object",
        },
      },
      "required": [
        "operationId",
      ],
      "type": "object",
    },
    "name": "discord_api_read",
    "title": "Call a read-only Discord API operation",
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Find Discord HTTP API operations by plain-language description, method, family, auth mode, or risk class.

Start here when no curated discord_* tool covers what you need. Results name the curated tool
when one exists — prefer it, since curated tools have stricter schemas and better errors.
Follow up with discord_api_describe before calling an unfamiliar operation.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "enum": [
            "bot",
            "oauth2",
            "webhook",
            "interaction",
          ],
          "type": "string",
        },
        "cursor": {
          "type": "string",
        },
        "family": {
          "description": "e.g. guild, channel, message, role, member.",
          "type": "string",
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
          ],
          "type": "string",
        },
        "query": {
          "description": "Plain language works: "kick a member", "post a message with buttons". Searches a maintained gloss of synonyms, because Discord's spec supplies no operation summaries.",
          "type": "string",
        },
        "risk": {
          "enum": [
            "read",
            "write",
            "destructive",
            "bot_admin",
            "credential",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "discord_api_search",
    "title": "Search the Discord API catalog",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true,
    },
    "description": "Execute any cataloged write operation — creates and updates that are normally reversible.
Deletes, bans, kicks, prunes, and bulk changes are not reachable here; they are
discord_api_destructive and require a preview token.

Supply auditLogReason on guild mutations so the change is attributable later.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "auditLogReason": {
          "description": "Recorded in the guild audit log. Say why, not what.",
          "type": "string",
        },
        "authProfile": {
