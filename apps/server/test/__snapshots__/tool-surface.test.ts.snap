  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
    },
    "description": "Read a single message.

Requires ViewChannel and ReadMessageHistory. Message content requires the MESSAGE_CONTENT
privileged intent — over REST as well as the Gateway — and this server diagnoses the
empty-content signature rather than returning silently blank fields.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "channelId": {
          "description": "A Discord ID: 17-21 decimal digits, always a string.",
          "examples": [
            "123456789012345678",
          ],
          "pattern": "^\\d{17,21}$",
          "title": "Snowflake",
          "type": "string",
        },
        "messageId": {
          "description": "A Discord ID: 17-21 decimal digits, always a string.",
          "examples": [
            "123456789012345678",
          ],
          "pattern": "^\\d{17,21}$",
          "title": "Snowflake",
          "type": "string",
        },
      },
      "required": [
        "channelId",
        "messageId",
      ],
      "type": "object",
    },
    "name": "discord_message_get",
    "title": "Read one message",
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
    },
    "description": "List recent messages, newest first. Pages by snowflake with before/after/around.

Requires ViewChannel and ReadMessageHistory. If every message comes back with empty content,
that is the MESSAGE_CONTENT intent signature, not empty messages — this server says so.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "description": "A Discord ID: 17-21 decimal digits, always a string.",
          "examples": [
            "123456789012345678",
          ],
          "pattern": "^\\d{17,21}$",
          "title": "Snowflake",
          "type": "string",
        },
        "around": {
          "description": "A Discord ID: 17-21 decimal digits, always a string.",
          "examples": [
            "123456789012345678",
          ],
          "pattern": "^\\d{17,21}$",
          "title": "Snowflake",
          "type": "string",
        },
        "before": {
          "description": "A Discord ID: 17-21 decimal digits, always a string.",
          "examples": [
            "123456789012345678",
          ],
          "pattern": "^\\d{17,21}$",
          "title": "Snowflake",
          "type": "string",
        },
        "channelId": {
          "description": "A Discord ID: 17-21 decimal digits, always a string.",
          "examples": [
            "123456789012345678",
          ],
          "pattern": "^\\d{17,21}$",
          "title": "Snowflake",
          "type": "string",
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
      },
      "required": [
        "channelId",
      ],
      "type": "object",
    },
