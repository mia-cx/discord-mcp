{
  "name": "discord-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "biome check . && pnpm typecheck && pnpm test",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --build",
    "build": "tsc --build",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node apps/server/dist/bin.js",
    "spec:generate": "tsx packages/discord-api/scripts/generate-catalog.ts",
    "spec:check": "tsx packages/discord-api/scripts/check-catalog.ts",
    "spec:drift": "tsx packages/discord-api/scripts/drift.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "24.10.1",
    "tsx": "4.21.1",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
