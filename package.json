{
  "name": "discord-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "login": "node scripts/login.mjs",
    "start": "node apps/server/dist/bin.js",
    "check": "biome check . && pnpm typecheck && pnpm test",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --build && node scripts/copy-assets.mjs",
    "build": "tsc --build && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node apps/server/dist/bin.js",
    "spec:generate": "tsx packages/discord-api/scripts/generate-catalog.ts",
    "spec:check": "tsx packages/discord-api/scripts/check-catalog.ts",
    "spec:drift": "tsx packages/discord-api/scripts/drift.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.10.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "3.2.6"
  }
}
