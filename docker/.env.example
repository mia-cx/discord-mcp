# Configure one Discord OAuth application for the relay. Callers supply their own bot tokens.
DISCORD_MCP_VERSION=main
PUBLIC_BASE_URL=https://mcp.example.com
ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1
ALLOWED_ORIGINS=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Comma-separated Discord user IDs. * allows any human; an empty value denies everyone.
DISCORD_OAUTH_ALLOWED_USER_IDS=*
# Generate once with: openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=
DISCORD_MCP_REST_TIMEOUT_MS=15000
# Optional bot hosting. Needs DISCORD_OAUTH_ALLOWED_USER_IDS to list users.
DATABASE_URL=
# Generate once with: openssl rand -base64 32
TOKEN_VAULT_KEY=
