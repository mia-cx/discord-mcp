# Configure one Discord OAuth application for the relay. Callers supply their own bot tokens.
DISCORD_MCP_VERSION=main
PUBLIC_BASE_URL=https://discord.mia.cx
ALLOWED_HOSTS=discord.mia.cx,localhost,127.0.0.1
ALLOWED_ORIGINS=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Generate once with: openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=
DISCORD_MCP_REST_TIMEOUT_MS=15000
