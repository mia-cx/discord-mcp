# Copy to `.env` and fill in. See ../docs/operating.md.

# ---------------------------------------------------------------- required

# Bot → Reset Token in the Developer Portal. Shown once.
DISCORD_TOKEN=

# 32 bytes: `openssl rand -base64 32`
#
# Encrypts every stored OAuth2 token and route secret. Back it up somewhere other than this host —
# losing it makes all of them permanently unrecoverable.
DISCORD_MCP_MASTER_KEY=

# ---------------------------------------------------------------- interactions and OAuth2

# Needed for slash commands, buttons, and modals. Discord sends a signed PING when you save the
# interactions endpoint URL and will not accept it unless verification succeeds.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Needed only to authorize OAuth2 profiles that act as a user rather than as the bot.
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------- exposure

# The externally reachable base URL, used for OAuth2 redirects and resource metadata.
PUBLIC_BASE_URL=

# Comma-separated. Required before binding anything but loopback.
ALLOWED_HOSTS=

# ---------------------------------------------------------------- tools

# `admin` adds blueprint apply, workflow granting, and OAuth profile management. Opt in
# deliberately: it is the difference between an agent that can read a guild and one that can
# reshape it.
DISCORD_MCP_TOOLSETS=operator,automation,api

# ---------------------------------------------------------------- workflows

# Off by default. Enabling this runs arbitrary agent-written code in containers.
#
# Rootless Docker is assumed. Under rootful Docker a container escape is a host root escape and the
# sandbox restrictions do not compensate — leave this off if you are not running rootless.
DISCORD_MCP_WORKFLOWS_ENABLED=false

# The same value on both services: `openssl rand -base64 32`
# This is what stops any other local process from driving the sandbox supervisor.
DISCORD_MCP_SUPERVISOR_CREDENTIAL=

# The rootless daemon's socket, on the host.
DOCKER_SOCKET=/run/user/1000/docker.sock
DOCKER_HOST=unix:///run/user/1000/docker.sock

DISCORD_MCP_NPM_REGISTRY=https://registry.npmjs.org/
