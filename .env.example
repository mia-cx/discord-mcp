DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_MCP_MASTER_KEY=
DISCORD_MCP_SUPERVISOR_CREDENTIAL=

MCP_TRANSPORT=http
PUBLIC_BASE_URL=https://discord-mcp.example.com
ALLOWED_HOSTS=discord-mcp.example.com
TRUSTED_PROXY_CIDRS=172.16.0.0/12
TRUST_PROXY_IDENTITY=false
TRUST_PROXY_IDENTITY_HEADER=x-forwarded-user
TRUST_PROXY_GROUPS_HEADER=x-forwarded-groups
DISCORD_MCP_HOST=discord-mcp.example.com

ROOTLESS_DOCKER_SOCKET=/run/user/1000/docker.sock
ROOTLESS_DOCKER_GID=1000
DISCORD_MCP_RUNTIME_GID=65532
DISCORD_MCP_BUILDER_IMAGE=discord-mcp/workflow-builder:local
DISCORD_MCP_RUNNER_IMAGE=discord-mcp/workflow-runner:local
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

DISCORD_MCP_TOOLSETS=operator,automation,api
DISCORD_MCP_GATEWAY_MODE=lazy
DISCORD_MCP_GATEWAY_INTENTS=Guilds
DISCORD_MCP_GATEWAY_BUFFER_SIZE=10000
DISCORD_MCP_GATEWAY_MAX_WAIT_MS=120000
DISCORD_MCP_REST_TIMEOUT_MS=15000
DISCORD_MCP_REST_RETRIES=2
DISCORD_MCP_REST_GLOBAL_RPS=50
DISCORD_MCP_REST_MAX_RATELIMIT_WAIT_MS=30000
DISCORD_MCP_REST_DENY_THRESHOLD=25
DISCORD_MCP_MAX_RESPONSE_BYTES=25000
DISCORD_MCP_BLOB_QUOTA_BYTES=262144000
DATABASE_PATH=data/discord-mcp.sqlite

# Explicit opt-in live test-guild suite (never ordinary CI)
DISCORD_MCP_E2E=false
DISCORD_MCP_TEST_GUILD_ID=
DISCORD_MCP_TEST_CHANNEL_ID=
DISCORD_MCP_TEST_MEMBER_ID=
DISCORD_MCP_TEST_FORBIDDEN_CHANNEL_ID=
DISCORD_MCP_TEST_OAUTH_TOKEN=

# Optional external OIDC resource-server verification
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
